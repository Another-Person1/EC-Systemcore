{
  "name": "ec-systemcore-configuration",
  "version": "2026.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bun build server.ts --target=bun --outfile dist/server.js",
    "start": "bun dist/server.js",
    "dev": "EC_SYSTEMCORE_PORT=8080 bun --watch server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint core.ts server.ts zip.ts tests public/app.js",
    "check:bundle": "bun build server.ts --target=bun --outfile dist/server.js",
    "check": "bun run typecheck && bun run lint && bun test && bun run check:bundle"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
