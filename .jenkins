pipeline {
  agent any

  options {
    disableConcurrentBuilds(abortPrevious: true)
    timeout(time: 45, unit: 'MINUTES')
    timestamps()
  }

  environment {
    CI_IMAGE = "ec-systemcore-ci:${BUILD_NUMBER}"
  }

  stages {
    stage('Pinned toolchain') {
      steps {
        sh '''
          set -eu
          docker build \
            --file .docker/linux-arm64.Dockerfile \
            --tag "${CI_IMAGE}" \
            .
        '''
      }
    }

    stage('ARM64 development validation') {
      steps {
        sh '''
          set -eu
          SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
          export SOURCE_DATE_EPOCH
          docker run --rm \
            --user "$(id -u):$(id -g)" \
            --env HOME=/tmp/ec-systemcore-ci-home \
            --env GIT_CONFIG_COUNT=1 \
            --env GIT_CONFIG_KEY_0=safe.directory \
            --env GIT_CONFIG_VALUE_0=/workspace \
            --env SOURCE_DATE_EPOCH \
            --volume "${WORKSPACE}:/workspace" \
            --workdir /workspace \
            "${CI_IMAGE}" \
            bash scripts/ci.sh development
        '''
      }
    }
  }

  post {
    success {
      archiveArtifacts(
        artifacts: 'dist/*.ipk,dist/*.spdx.json,dist/SHA256SUMS',
        fingerprint: true
      )
    }
    cleanup {
      sh '''
        docker image rm "${CI_IMAGE}" >/dev/null 2>&1 || true
      '''
    }
  }
}
